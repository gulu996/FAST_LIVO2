<launch>
  <arg name="cmd_name" default="" />
  <arg name="rviz" default="true" />
  <arg name="play_bag" default="true" />
  <arg name="bag" default="/media/gulu/一只沙糖桔/Outdoor01/Outdoor01.bag" />
  <arg name="bag_start" default="0.0" />
  <arg name="bag_rate" default="3.0" />
  <arg name="bag_delay" default="2.0" />
  <arg name="bag_queue" default="10000" />
  <arg name="debug_prefix" default="" />

  <param name="/use_sim_time" value="true" />

  <rosparam command="load" file="$(find fast_livo)/config/m3dgr/mid360.yaml" />
  <param name="/bag_start_offset" value="$(arg bag_start)" />

  <node if="$(arg play_bag)" pkg="rosbag" type="play" name="outdoor01_bag" output="screen"
        args="--clock --wait-for-subscribers --delay=$(arg bag_delay) --queue=$(arg bag_queue) -r $(arg bag_rate) -s $(arg bag_start) $(arg bag) --topics /camera/color/image_raw/compressed /livox/mid360/lidar /livox/mid360/imu" />

  <node pkg="image_transport" type="republish" name="republish_color_compressed_to_raw"
        args="compressed in:=/camera/color/image_raw raw out:=/camera/color/image_raw"
        output="screen" respawn="true" />

  <node launch-prefix="$(arg debug_prefix)" pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <param name="save_path" type="string" value="$(arg cmd_name)" />
    <rosparam file="$(find fast_livo)/config/m3dgr/camera_pinhole_mid360.yaml" />
  </node>

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
